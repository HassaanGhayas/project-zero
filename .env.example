# AI FTE Environment Configuration
# Copy to .env and fill in values. NEVER commit .env itself.

# Vault path (absolute)
VAULT_PATH=/home/hasss/projects/project-zero/AI_Employee_Vault

# Development mode
DRY_RUN=true
DEV_MODE=true

# Watcher configuration
WATCHER_CHECK_INTERVAL=5
INBOX_WATCH_PATH=/home/hasss/projects/project-zero/AI_Employee_Vault/Inbox

# Gmail Integration (Silver Tier Phase 1)
GMAIL_CREDENTIALS_PATH=/home/hasss/.google/credentials.json
GMAIL_TOKEN_PATH=/home/hasss/.google/token.json
GMAIL_CHECK_INTERVAL=120

# WhatsApp Business API Integration (Silver Tier Phase 2)
# Get these from https://developers.facebook.com/apps/<your-app>/whatsapp-business/
WHATSAPP_ACCESS_TOKEN=your_permanent_system_user_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_VERIFY_TOKEN=your_webhook_verify_token_here   # any secret string you choose
WHATSAPP_WEBHOOK_PORT=8081
WHATSAPP_CHECK_INTERVAL=30
WHATSAPP_QUEUE_FILE=/home/hasss/.whatsapp/message_queue.json
