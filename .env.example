# AI FTE Environment Configuration
# Copy to .env and fill in values. NEVER commit .env itself.

# Vault path (absolute)
VAULT_PATH=/home/hasss/projects/project-zero/AI_Employee_Vault

# Development mode
DRY_RUN=true
DEV_MODE=true

# Watcher configuration
WATCHER_CHECK_INTERVAL=5
INBOX_WATCH_PATH=/home/hasss/projects/project-zero/AI_Employee_Vault/Inbox

# Gmail Integration (Silver Tier Phase 1)
GMAIL_CREDENTIALS_PATH=/home/hasss/.google/credentials.json
GMAIL_TOKEN_PATH=/home/hasss/.google/token.json
GMAIL_CHECK_INTERVAL=120

# WhatsApp Integration (Silver Tier Phase 2)
WHATSAPP_SESSION_PATH=/home/hasss/.whatsapp/session
WHATSAPP_CHECK_INTERVAL=30
PLAYWRIGHT_HEADLESS=true
